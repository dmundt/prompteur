{
  "name": "prompteur",
  "displayName": "Prompteur",
  "description": "Git-friendly local Markdown prompts with categories, tags, and clipboard generation.",
  "version": "1.1.0",
  "publisher": "dmundt",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmundt/prompteur.git"
  },
  "bugs": {
    "url": "https://github.com/dmundt/prompteur/issues"
  },
  "homepage": "https://github.com/dmundt/prompteur#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "onLanguageModelTool:prompteur_findPrompt"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workspace library writes and prompt generation require Workspace Trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prompteur",
          "title": "Prompteur",
          "icon": "resources/activity/prompts.svg"
        }
      ]
    },
    "views": {
      "prompteur": [
        {
          "id": "prompteur.prompts",
          "name": "Prompts"
        }
      ]
    },
    "configuration": {
      "title": "Prompteur",
      "properties": {
        "prompteur.defaultScope": {
          "type": "string",
          "enum": [
            "ask",
            "user",
            "workspace"
          ],
          "default": "ask",
          "scope": "window",
          "description": "Default destination for prompts and starters when no library is targeted."
        },
        "prompteur.preferredCategory": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Preselect this approved category when choosing a category for a new prompt."
        },
        "prompteur.showTags": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show tags beside prompt names in the Prompteur view."
        },
        "prompteur.categoryCountMode": {
          "type": "string",
          "enum": [
            "filtered",
            "total",
            "hidden"
          ],
          "default": "filtered",
          "scope": "window",
          "description": "Choose whether category counts show filtered matches, all valid prompts, or stay hidden."
        },
        "prompteur.groupByCategory": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Group prompts by category; turn off for a flat list."
        },
        "prompteur.syncUserPrompts": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Sync User prompts across VS Code instances using Settings Sync."
        }
      }
    },
    "commands": [
      {
        "command": "prompteur.addStarters",
        "title": "Add Starter Library",
        "category": "Prompteur",
        "icon": "$(library)"
      },
      {
        "command": "prompteur.removeCategory",
        "title": "Remove Prompt Category",
        "category": "Prompteur"
      },
      {
        "command": "prompteur.newPrompt",
        "title": "New",
        "category": "Prompteur",
        "icon": "$(add)"
      },
      {
        "command": "prompteur.edit",
        "title": "Edit",
        "category": "Prompteur",
        "icon": "$(edit)"
      },
      {
        "command": "prompteur.delete",
        "title": "Delete",
        "category": "Prompteur",
        "icon": "$(trash)"
      },
      {
        "command": "prompteur.duplicate",
        "title": "Duplicate",
        "category": "Prompteur",
        "icon": "$(files)"
      },
      {
        "command": "prompteur.copy",
        "title": "Copy Text",
        "category": "Prompteur",
        "icon": "$(copy)"
      },
      {
        "command": "prompteur.copyPrompt",
        "title": "Copy Prompt",
        "category": "Prompteur",
        "icon": "$(copy)"
      },
      {
        "command": "prompteur.pastePrompt",
        "title": "Paste Prompt",
        "enablement": "prompteur.hasCopiedPrompt",
        "category": "Prompteur",
        "icon": "$(clippy)"
      },
      {
        "command": "prompteur.preview",
        "title": "Preview",
        "category": "Prompteur",
        "icon": "$(open-preview)"
      },
      {
        "command": "prompteur.search",
        "title": "Filter Prompts",
        "category": "Prompteur",
        "icon": "$(search)"
      },
      {
        "command": "prompteur.clearSearch",
        "title": "Clear Filter",
        "category": "Prompteur",
        "icon": "$(clear-all)"
      },
      {
        "command": "prompteur.refresh",
        "title": "Reload Libraries",
        "category": "Prompteur",
        "icon": "$(refresh)"
      },
      {
        "command": "prompteur.openSettings",
        "title": "Prompteur Settings",
        "category": "Prompteur",
        "icon": "$(gear)"
      }
    ],
    "languageModelTools": [
      {
        "name": "prompteur_findPrompt",
        "toolReferenceName": "prompteurPrompt",
        "displayName": "Find Prompteur Prompt",
        "modelDescription": "Search local Prompteur prompt libraries and return one matching prompt with its existing variables rendered. Use only when the user asks to find or use a saved prompt. If multiple prompts match, return candidate metadata and ask for a more specific query. Never modify prompts or libraries.",
        "userDescription": "Find and return a matching saved prompt. Returned prompt text and requested context variables are shared with Copilot Chat.",
        "canBeReferencedInPrompt": true,
        "icon": "$(library)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Text to search in prompt names, descriptions, categories, tags, paths, and content."
            },
            "scope": {
              "type": "string",
              "enum": [
                "user",
                "workspace"
              ],
              "description": "Optional library to search. Workspace prompts require Workspace Trust."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "prompteur.duplicate",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "prompteur.addStarters",
          "when": "view == prompteur.prompts",
          "group": "create"
        },
        {
          "command": "prompteur.newPrompt",
          "when": "view == prompteur.prompts",
          "group": "navigation@1"
        },
        {
          "command": "prompteur.search",
          "when": "view =~ /^prompteur\\./",
          "group": "navigation@3"
        },
        {
          "command": "prompteur.openSettings",
          "when": "view == prompteur.prompts",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "prompteur.copy",
          "when": "view =~ /^prompteur\\./ && viewItem == prompt",
          "group": "inline@1"
        },
        {
          "command": "prompteur.copy",
          "when": "view =~ /^prompteur\\./ && viewItem == prompt",
          "group": "0_text@1"
        },
        {
          "command": "prompteur.copyPrompt",
          "when": "view =~ /^prompteur\\./ && viewItem == prompt",
          "group": "1_prompt@1"
        },
        {
          "command": "prompteur.preview",
          "when": "view =~ /^prompteur\\./ && viewItem == prompt",
          "group": "1_prompt@2"
        },
        {
          "command": "prompteur.edit",
          "when": "view =~ /^prompteur\\./ && viewItem =~ /^(prompt|problem)$/",
          "group": "2_edit@1"
        },
        {
          "command": "prompteur.delete",
          "when": "view =~ /^prompteur\\./ && viewItem == prompt",
          "group": "3_delete@1"
        },
        {
          "command": "prompteur.pastePrompt",
          "when": "view == prompteur.prompts && viewItem =~ /^(scope|category)$/",
          "group": "create@2"
        },
        {
          "command": "prompteur.newPrompt",
          "when": "view == prompteur.prompts && viewItem =~ /^(scope|category)$/",
          "group": "create@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run check && npm run schemas && esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --sourcemap --minify",
    "schemas": "esbuild scripts/schemas.ts --bundle --platform=node --packages=external --outfile=dist/schema.cjs && node dist/schema.cjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:host": "npm run build && esbuild tests/host/smoke.ts --bundle --platform=node --external:vscode --outfile=dist/host-smoke.cjs && node scripts/run-host-tests.mjs",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "vsce package --allow-missing-repository --no-rewrite-relative-links --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
